rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function googleUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function ownsClass(classId) {
      return signedIn() && get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
    }
    function enrolled(classId) {
      return signedIn() && exists(/databases/$(database)/documents/classMembers/$(classId)/students/$(request.auth.uid));
    }
    function validCode(code) {
      return code is string && code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{10}$');
    }
    function validMembership(data, classId, uid) {
      return googleUser() && request.auth.uid == uid
        && data.keys().hasAll(['classId', 'uid', 'ownerUid', 'alias', 'joinCode', 'joinedAt'])
        && data.keys().hasOnly(['classId', 'uid', 'ownerUid', 'alias', 'joinCode', 'joinedAt'])
        && data.classId == classId && data.uid == uid
        && data.ownerUid == get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid
        && data.alias is string && data.alias.size() >= 1 && data.alias.size() <= 20
        && validCode(data.joinCode)
        && getAfter(/databases/$(database)/documents/classCodes/$(data.joinCode)).data.classId == classId
        && getAfter(/databases/$(database)/documents/classCodes/$(data.joinCode)).data.ownerUid == data.ownerUid
        && getAfter(/databases/$(database)/documents/classEnrollment/$(classId)).data.code == data.joinCode
        && data.joinedAt == request.time;
    }
    function owner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    function validClass(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'notices', 'assessments', 'students', 'videos', 'published', 'version', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'notices', 'assessments', 'students', 'videos', 'published', 'version', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.notices is list && data.notices.size() <= 100
        && data.assessments is list && data.assessments.size() <= 100
        && data.students is list && data.students.size() <= 60
        && data.videos is list && data.videos.size() <= 50
        && data.published is bool
        && data.version is int && data.version >= 0
        && data.updatedAt == request.time;
    }
    match /classEnrollment/{classId} {
      function validSettings(data) {
        return data.keys().hasAll(['code', 'ownerUid', 'updatedAt'])
          && data.keys().hasOnly(['code', 'ownerUid', 'updatedAt'])
          && validCode(data.code) && data.ownerUid == request.auth.uid
          && data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/classCodes/$(data.code)).data.classId == classId
          && getAfter(/databases/$(database)/documents/classCodes/$(data.code)).data.ownerUid == data.ownerUid
          && getAfter(/databases/$(database)/documents/classCodes/$(data.code)).data.createdAt == request.time;
      }
      allow get: if ownsClass(classId);
      allow list, delete: if false;
      allow create: if ownsClass(classId) && validSettings(request.resource.data);
      allow update: if ownsClass(classId) && validSettings(request.resource.data)
        && request.resource.data.code != resource.data.code
        && !existsAfter(/databases/$(database)/documents/classCodes/$(resource.data.code));
    }
    match /classCodes/{code} {
      allow get: if googleUser();
      allow list, update: if false;
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasAll(['classId', 'ownerUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['classId', 'ownerUid', 'createdAt'])
        && request.resource.data.classId is string
        && ownsClass(request.resource.data.classId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/classEnrollment/$(request.resource.data.classId)).data.code == code
        && getAfter(/databases/$(database)/documents/classEnrollment/$(request.resource.data.classId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/classEnrollment/$(request.resource.data.classId)).data.updatedAt == request.time;
      allow delete: if ownsClass(resource.data.classId)
        && get(/databases/$(database)/documents/classEnrollment/$(resource.data.classId)).data.code == code
        && getAfter(/databases/$(database)/documents/classEnrollment/$(resource.data.classId)).data.code != code
        && getAfter(/databases/$(database)/documents/classEnrollment/$(resource.data.classId)).data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/classCodes/$(getAfter(/databases/$(database)/documents/classEnrollment/$(resource.data.classId)).data.code)).data.classId == resource.data.classId;
    }
    match /classMembers/{classId}/students/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || ownsClass(classId);
      allow list: if ownsClass(classId);
      allow create: if validMembership(request.resource.data, classId, uid)
        && getAfter(/databases/$(database)/documents/studentClasses/$(uid)/classes/$(classId)).data == request.resource.data;
      allow update, delete: if false;
    }
    match /studentClasses/{uid}/classes/{classId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create: if validMembership(request.resource.data, classId, uid)
        && getAfter(/databases/$(database)/documents/classMembers/$(classId)/students/$(uid)).data == request.resource.data;
      allow update, delete: if false;
    }
    match /classes/{classId} {
      allow get: if resource.data.published == true || owner() || enrolled(classId);
      allow list: if owner();
      allow create: if signedIn()
        && classId.matches('^[A-Za-z0-9]{20}$')
        && validClass(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.version == 0
        && request.resource.data.published == false;
      allow update: if owner()
        && validClass(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if owner();
      match /videoActivity/{videoKey} {
        function classData() {
          return get(/databases/$(database)/documents/classes/$(classId)).data;
        }
        function classOwner() {
          return signedIn() && classData().ownerUid == request.auth.uid;
        }
        function accessible() {
          return classData().published == true || classOwner() || enrolled(classId);
        }
        function participant() {
          return googleUser() && (classOwner() || enrolled(classId));
        }
        function currentVideo(video) {
          return video is map && video.id == videoKey && classData().videos.hasAny([video]);
        }
        match /comments/{commentId} {
          function validParent(parentId) {
            return parentId == '' || (parentId is string && parentId != commentId
              && parentId.matches('^[A-Za-z0-9_-]{1,128}$')
              && exists(/databases/$(database)/documents/classes/$(classId)/videoActivity/$(videoKey)/comments/$(parentId))
              && get(/databases/$(database)/documents/classes/$(classId)/videoActivity/$(videoKey)/comments/$(parentId)).data.parentId == ''
              && get(/databases/$(database)/documents/classes/$(classId)/videoActivity/$(videoKey)/comments/$(parentId)).data.deleted == false);
          }
          allow read: if accessible();
          allow create: if participant()
            && request.resource.data.keys().hasAll(['authorUid', 'alias', 'body', 'parentId', 'video', 'createdAt', 'deleted'])
            && request.resource.data.keys().hasOnly(['authorUid', 'alias', 'body', 'parentId', 'video', 'createdAt', 'deleted'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.alias is string && request.resource.data.alias.size() >= 1 && request.resource.data.alias.size() <= 20
            && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 1000
            && validParent(request.resource.data.parentId)
            && currentVideo(request.resource.data.video)
            && request.resource.data.createdAt == request.time
            && request.resource.data.deleted == false;
          allow update: if participant()
            && (resource.data.authorUid == request.auth.uid || classOwner())
            && resource.data.deleted == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'deleted'])
            && request.resource.data.body == '' && request.resource.data.deleted == true;
          allow delete: if false;
        }
        match /reactions/{uid} {
          allow read: if accessible();
          allow create, update: if participant() && uid == request.auth.uid
            && request.resource.data.keys().hasAll(['authorUid', 'type', 'video', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['authorUid', 'type', 'video', 'updatedAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.type in ['heart', 'thumbsUp', 'idea', 'clap']
            && currentVideo(request.resource.data.video)
            && request.resource.data.updatedAt == request.time;
          allow delete: if participant() && uid == request.auth.uid
            && resource.data.authorUid == request.auth.uid;
        }
      }
    }
  }
}
